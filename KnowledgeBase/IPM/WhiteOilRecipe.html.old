  "description": "An organic two-ingredient White Oil concentrate that suffocates soft-bodied pests like Aphids and Whiteflies without harsh chemicals. A Sacred Grove corrective action recipe.",
  "image": "https://tropicalrootsmaui.com/img/whiteoil.webp",
  "url": "https://tropicalrootsmaui.com/KnowledgeBase/IPM/WhiteOilRecipe.html",
  "supply": [
    { "@type": "HowToSupply", "name": "Vegetable Oil (canola or sunflower)", "requiredQuantity": "1 cup" },
    { "@type": "HowToSupply", "name": "Liquid Dish Soap (organic/biodegradable)", "requiredQuantity": "1/4 cup" }
  ],
  "tool": [
    { "@type": "HowToTool", "name": "Glass jar with lid" },
    { "@type": "HowToTool", "name": "Spray bottle (1 liter)" }
  ],
  "step": [
    { "@type": "HowToStep", "name": "Create the Concentrate", "text": "Mix the oil and soap in a jar and shake vigorously until it turns a milky white color." },
    { "@type": "HowToStep", "name": "Dilute for Use", "text": "Add 2 teaspoons of white oil concentrate to 1 liter of water in a spray bottle." },
    { "@type": "HowToStep", "name": "Shake Well", "text": "Always shake before each use to keep the oil and water combined." },
    { "@type": "HowToStep", "name": "Spray the Canopy", "text": "Thoroughly coat the leaves, paying special attention to leaf undersides where pests hide." },
    { "@type": "HowToStep", "name": "Timing", "text": "Apply in the early morning or evening to avoid sunlight burning the leaves while the oil is wet." }
